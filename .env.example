# Copy this file to .env and replace the placeholders with your real keys.
# Never commit .env.

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Paid-tier list prices (USD per 1M tokens). Free tier is $0, but we use
# published rates so the cost math is meaningful for the assignment.
GEMINI_INPUT_PRICE_PER_M=0.30
GEMINI_OUTPUT_PRICE_PER_M=2.50

# GroqCloud: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_INPUT_PRICE_PER_M=0.075
GROQ_OUTPUT_PRICE_PER_M=0.30
